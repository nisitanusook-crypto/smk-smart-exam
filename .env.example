# =============================================================================
# SMK Smart Exam — ตัวอย่างการตั้งค่า Environment
# สำหรับพัฒนาในเครื่อง: คัดลอกไฟล์นี้ไปเป็น server/.env
#     cp .env.example server/.env
# บน Render.com: ค่าเหล่านี้ถูกกำหนดผ่าน render.yaml / หน้า Environment ของ Service
# ห้าม commit ไฟล์ .env ที่มีค่าจริงขึ้น Git
# =============================================================================

# ---------- Server ----------
NODE_ENV=development
PORT=4000

# ---------- Database (PostgreSQL) ----------
# รูปแบบ: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://smk:smk_dev_pw@localhost:5432/smk_smart_exam?schema=public"

# ---------- Authentication ----------
# ต้องยาวอย่างน้อย 32 ตัวอักษร สร้างได้ด้วย:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=10

# ระบุเฉพาะเมื่อ Frontend อยู่คนละโดเมนกับ Backend (คั่นหลายค่าด้วย ,)
# CORS_ORIGIN=https://example.com

# ---------- Seed (บัญชีผู้ดูแลระบบคนแรก) ----------
SEED_ADMIN_USERNAME=admin
# อย่างน้อย 8 ตัวอักษร — ใช้เฉพาะตอนสร้างบัญชีครั้งแรก จากนั้นให้เปลี่ยนรหัสผ่านในระบบ
SEED_ADMIN_PASSWORD=
# true = สร้างบัญชีครู/นักเรียนตัวอย่าง (ใช้ได้เฉพาะ NODE_ENV ที่ไม่ใช่ production)
SEED_DEMO_USERS=false

# ---------- Frontend (ไม่บังคับ) ----------
# ปกติ Frontend เรียก /api ในโดเมนเดียวกัน ระบุเมื่อแยก Backend ไปโดเมนอื่น
# VITE_API_URL=https://api.example.com/api
